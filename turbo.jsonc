{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    // Environment context
    "NODE_ENV",
    "CI",
    "NEXT_TELEMETRY_DISABLED",
    "SKIP_NODE_VERSION_CHECK",
    "NEXT_BUILD_DIR",

    // Public URLs
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_KEEL_API_BASE",
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "main/**", "module/**", "types/**", ".next/**"],
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
    },
    "lint": {
      "outputs": [],
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
    },
  },
}
