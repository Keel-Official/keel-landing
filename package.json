{
  "name": "keel-landing",
  "description": "Keel landing page",
  "version": "1.7.2",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=keel-web",
    "dev:experimental": "yarn workspace keel-web dev:experimental",
    "build:web": "turbo run build --filter=keel-web",
    "clean": "rm -rf node_modules .turbo yarn.lock && rm -rf packages/*/{node_modules,.next,.swc,dist,build,tsconfig.tsbuildinfo,.turbo}",
    "setup": "yarn install && yarn build",
    "refresh": "yarn run clean && yarn run setup",
    "prepare": "husky"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/contracts",
    "packages/types",
    "packages/utils",
    "packages/state",
    "packages/web"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@tsconfig/recommended": "^1.0.2",
    "@types/jest": "^29.5.2",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.1.5",
    "prettier-plugin-organize-imports": "^4.2.0",
    "turbo": "^2.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.4",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/figtree": "^5.2.8",
    "clsx": "^2.1.1",
    "next": "15.0.5",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.3.1"
  }
}
